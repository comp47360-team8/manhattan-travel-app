DATABASE_URL=YOUR_DATABASE_URL
JWT_SECRET_KEY=ANY_RANDOM_STRING
ALGORITHM=HS256 
ACCESS_TOKEN_EXPIRE_MINUTES=15 
REFRESH_TOKEN_EXPIRE_DAYS=30 
ALLOWED_ORIGINS=http://localhost:5173 
GEMINI_API_KEY=
GROQ_API_KEY=
AI_PROVIDER=fallback
# Optional. Route Gemini's outbound calls through a proxy to avoid the
# "User location is not supported" geo-block on some hosting egress IPs.
# Use a Webshare rotating endpoint (handles IP churn) or a comma-separated list.
# e.g. http://user:pass@p.webshare.io:80
GEMINI_PROXY_URL=
GEMINI_PROXY_RETRIES=3
